APP_NAME="كلية التقنية الإلكترونية – طرابلس"
APP_ENV=local
APP_KEY=
# Safe-by-default: keep false so a forgotten override never leaks stack traces in prod.
# For local development set APP_DEBUG=true (and APP_ENV=local).
APP_DEBUG=false
APP_URL=http://localhost
# Libya is UTC+2 (no DST). Leave as Africa/Tripoli so exam/deadline times are correct.
APP_TIMEZONE=Africa/Tripoli

APP_LOCALE=ar
APP_FALLBACK_LOCALE=ar
APP_FAKER_LOCALE=ar_SA

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
# Docker/Dokploy: log to file AND stderr so `docker logs` shows errors even if storage/logs is mis-permissioned.
LOG_STACK=single,stderr
LOG_DEPRECATIONS_CHANNEL=null
# Production-safe default; use LOG_LEVEL=debug locally when you need verbose logs.
LOG_LEVEL=warning

DB_CONNECTION=sqlite
# --- Production (Docker / Dokploy Application + separate Postgres service) ---
# DB_CONNECTION=pgsql
# DB_HOST=your-postgres-internal-host
# DB_PORT=5432
# DB_DATABASE=graduate_project
# DB_USERNAME=graduate
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# MUST be true in production (behind HTTPS) so the session cookie is sent only over TLS.
# Keep false for local plain-HTTP dev, or the login cookie won't be set and you can't sign in.
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
# Seconds before a synchronous SMTP send is abandoned (notifications send inline).
# MAIL_TIMEOUT=10

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

QONVO_API_TOKEN=
QONVO_SENDER_PHONE=
QONVO_WEBHOOK_SECRET=

VITE_APP_NAME="${APP_NAME}"
